@startuml v8_activity
skinparam defaultFontSize 12
title escape_room_v8.3 – jeden tah (searcher + coordinator)

start
repeat
  :**select** – round-robin výběr searchera;
  :**searcher** (gemma3:12b / qwen2.5-coder:7b)
  vrací SemanticAction;
  :**compiler**
  verb, resolver, location + tool check, filtr;
  if (compile ok?) then (ano)
    :**engine.apply_command**
    O2 -= 1;
  else (ne)
    :**compile_error**
    turn += 1;
  endif
  :**observe** – update blackboard;
  if (nová fakta?) then (ano)
    :zápis faktů (write-on-change);
  endif
  if (turn mod K == 0?) then (ano)
    #DDEEFF:**coordinator** (deterministická heuristika)
    direktiva {focus_kind, focus_id}
    žádný verb, žádná rada;
  endif
  :**gate** – escape / O2 / budget / stagnace;
repeat while (běh nekončí?) is (ano)
:END;
stop

@enduml


@startuml v8_components
skinparam defaultFontSize 12
title escape_room_v8.3 – komponenty

actor "Marta / CI" as U

package "FastAPI" {
  [app/api/main.py] as API
}

package "LangGraph" {
  [select] as SEL
  [searcher] as S
  [act] as A
  [observe] as O
  [coordinator] as C
  [gate] as G
}

package "Core" {
  [engine.py] as E
  [compiler.py\n+ filtr] as K
  [blackboard.py\nfacts] as B
  [models.py\nFact, Directive] as M
}

database "blackboard\n(fakta, historie)" as BB

cloud "Ollama (lokálně)" {
  [gemma3:12b] as GM
  [qwen2.5-coder:7b] as QW
}

U --> API : POST /run {seed, temperature,\nguard_mode, filter_mode}
API --> SEL
SEL --> S
S --> GM
S --> QW
S --> A
A --> K
K --> E
E --> O
O --> B
B --> BB
O --> C : každé K tahů
C --> BB : čte fakta
C --> SEL : direktiva „kam“
O --> G
G --> SEL : další tah
G --> API : konec běhu

note bottom of C
  Deterministická heuristika:
  nejméně pokrytá místnost/objekt.
  LLM coordinator je samostatné rameno.
end note

@enduml

